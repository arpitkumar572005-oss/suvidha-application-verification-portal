# Suvidha Backend Configuration Example
PORT=5000
MONGODB_URI=mongodb://localhost:27017/suvidha
JWT_SECRET=replace_with_secure_random_secret_in_production
STORAGE_MODE=auto # 'auto' attempts MongoDB and falls back to persistent local JSON store
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
OCR_PROVIDER=mock # Options: 'mock' (rule-based demo provider) or 'tesseract' (when installed)
DEMO_ENVIRONMENT=true
